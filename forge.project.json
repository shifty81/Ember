{
  "$schema": "https://schemas.local/forge/project-v1.schema.json",
  "schema_version": 1,
  "id": "ember",
  "name": "Ember",
  "kind": "rust-game-authoring-suite",
  "repository": {
    "provider": "github",
    "remote": "https://github.com/shifty81/Ember.git",
    "default_branch": "main"
  },
  "capability_catalog": "config/ember/capabilities.json",
  "capabilities": [
    "build",
    "test",
    "validate",
    "run",
    "git",
    "artifacts",
    "debug-bundle",
    "source-refresh",
    "project-control-center",
    "green-gate",
    "patch-intake",
    "transactional-recovery",
    "dependency-bootstrap",
    "packages",
    "jobs",
    "session",
    "asset-catalog"
  ],
  "commands": {
    "build.editor": {
      "program": "cargo",
      "args": [
        "build",
        "-p",
        "ember_editor"
      ]
    },
    "build.runtime": {
      "program": "cargo",
      "args": [
        "build",
        "-p",
        "ember_runtime_host"
      ]
    },
    "test": {
      "program": "cargo",
      "args": [
        "test",
        "--workspace"
      ]
    },
    "test.certification": {
      "program": "cargo",
      "args": [
        "test",
        "-p",
        "ember_tools",
        "--test",
        "certification"
      ]
    },
    "validate.architecture": {
      "program": "cargo",
      "args": [
        "run",
        "-p",
        "ember_validation",
        "--bin",
        "ember_validate",
        "--",
        "architecture",
        "."
      ]
    },
    "check": {
      "program": "cargo",
      "args": [
        "check",
        "--workspace",
        "--all-targets"
      ]
    },
    "fmt.check": {
      "program": "cargo",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ]
    },
    "clippy.strict": {
      "program": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ]
    },
    "run.editor": {
      "program": "cargo",
      "args": [
        "run",
        "-p",
        "ember_editor"
      ]
    },
    "run.runtime": {
      "program": "cargo",
      "args": [
        "run",
        "-p",
        "ember_runtime_host"
      ]
    }
  },
  "integrations": {
    "cortex": "integrations/cortex/adapter.json"
  },
  "project_control_center": {
    "entry": "PROJECT_CONTROL_CENTER.cmd",
    "implementation": "tools/control_center/ember_pcc.py",
    "external_runtime_required": false,
    "profile": "project-control-center.profile.json"
  }
}

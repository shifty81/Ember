    "run-editor",
    "run-runtime",
    "patch-intake",
    "transactional-recovery",
    "debug-bundle",
    "source-snapshot",
    "dependency-bootstrap",
    "architecture-validation",
    "certification-smoke"
  ],
  "artifacts_root": "artifacts"
